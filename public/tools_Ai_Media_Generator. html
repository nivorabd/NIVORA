<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nivora AI Media Studio | Enterprise Cinematic AI Platform</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Noto+Sans+Bengali:wght@400;600;700&family=Noto+Sans+Devanagari:wght@400;600;700&family=Noto+Sans+Arabic:wght@400;600;700&family=Noto+Sans+Sinhala:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        navy: { 900: '#070913', 800: '#0c1021', 700: '#131932', 600: '#1b2347' },
                        electric: { 500: '#3b82f6', 600: '#2563eb' },
                        violet: { 600: '#7c3aed', 700: '#6d28d9' },
                        cyan: { 400: '#22d3ee', 500: '#06b6d4', glow: 'rgba(34, 211, 238, 0.25)' }
                    },
                    fontFamily: {
                        sans: ['Inter', 'Noto Sans Bengali', 'Noto Sans Devanagari', 'Noto Sans Arabic', 'Noto Sans Sinhala', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <style>
        .glow-border { border: 1px solid rgba(34, 211, 238, 0.3); box-shadow: 0 0 20px rgba(34, 211, 238, 0.1); }
        .glow-card:hover { border-color: rgba(34, 211, 238, 0.7); box-shadow: 0 0 25px rgba(34, 211, 238, 0.2); }
        .bg-gradient-studio { background: radial-gradient(circle at top right, #1b2347 0%, #0c1021 50%, #070913 100%); }
        .custom-scrollbar::-webkit-scrollbar { width: 6px; height: 6px; }
        .custom-scrollbar::-webkit-scrollbar-track { background: #0c1021; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: #22d3ee55; border-radius: 3px; }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: #22d3ee; }
        @keyframes pulseGlow { 0%, 100% { opacity: 0.4; } 50% { opacity: 0.8; } }
        .animate-pulse-glow { animation: pulseGlow 3s infinite ease-in-out; }
    </style>
</head>
<body class="bg-navy-900 text-slate-100 font-sans min-h-screen flex flex-col custom-scrollbar selection:bg-cyan-500 selection:text-navy-900" dir="ltr" id="bodyRoot">

    <!-- TOP HEADER -->
    <header class="bg-navy-800/90 backdrop-blur-md border-b border-slate-800 sticky top-0 z-50 px-4 py-3 flex items-center justify-between">
        <div class="flex items-center space-x-3">
            <button id="mobileMenuBtn" class="md:hidden text-cyan-400 hover:text-cyan-300 p-2" aria-label="Toggle mobile menu"><i class="fa-solid fa-bars text-xl"></i></button>
            <div class="flex items-center space-x-2">
                <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-electric-600 via-violet-600 to-cyan-400 flex items-center justify-center glow-border shadow-lg shadow-cyan-500/20">
                    <i class="fa-solid fa-clapperboard text-white text-sm"></i>
                </div>
                <div>
                    <span class="text-lg font-extrabold tracking-wider bg-gradient-to-r from-white via-cyan-200 to-cyan-400 bg-clip-text text-transparent">NIVORA</span>
                    <span class="text-xs font-semibold text-cyan-400 block tracking-widest uppercase -mt-1">AI MEDIA STUDIO</span>
                </div>
            </div>
            <!-- Live Clock & Status -->
            <div class="hidden lg:flex items-center space-x-4 pl-6 border-l border-slate-700 text-xs text-slate-400">
                <span class="flex items-center space-x-1.5"><span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span><span id="backendStatusText">Worker Connected</span></span>
                <span><i class="fa-regular fa-clock mr-1"></i><span id="liveClock">00:00:00</span></span>
            </div>
        </div>

        <!-- Header Actions: Language, Credits, Plan, Profile -->
        <div class="flex items-center space-x-3">
            <!-- Language Selector -->
            <div class="relative">
                <select id="langSelector" onchange="changeLanguage(this.value)" class="bg-navy-700 border border-slate-700 text-xs rounded-lg px-2.5 py-1.5 text-slate-200 focus:outline-none focus:border-cyan-400 cursor-pointer" aria-label="Select language">
                    <option value="en" selected>English</option>
                    <option value="bn">বাংলা (Bengali)</option>
                    <option value="hi">हिन्दी (Hindi)</option>
                    <option value="ur">اردو (Urdu)</option>
                    <option value="ar">العربية (Arabic)</option>
                    <option value="ne">नेपाली (Nepali)</option>
                    <option value="si">සිංහල (Sinhala)</option>
                </select>
            </div>

            <!-- Credits Badge -->
            <div onclick="openModal('upgradeModal')" class="hidden sm:flex items-center space-x-2 bg-navy-700/80 border border-slate-700 px-3 py-1.5 rounded-xl cursor-pointer hover:border-cyan-400/50 transition" role="button" tabindex="0">
                <i class="fa-solid fa-coins text-cyan-400 text-sm"></i>
                <div class="text-xs">
                    <span class="text-slate-400" data-i18n="creditsLabel">Credits:</span>
                    <span id="userCreditsDisplay" class="font-bold text-cyan-300">250</span>
                </div>
                <span class="bg-violet-600/30 text-violet-300 text-[10px] font-bold px-1.5 py-0.5 rounded border border-violet-500/30" id="planBadgeText">PRO</span>
            </div>

            <!-- Theme Toggle -->
            <button onclick="toggleTheme()" class="w-9 h-9 rounded-xl bg-navy-700 border border-slate-700 flex items-center justify-center text-slate-300 hover:text-cyan-400 transition" aria-label="Toggle theme">
                <i class="fa-solid fa-moon" id="themeIcon"></i>
            </button>

            <!-- User Profile Button -->
            <button onclick="openModal('authModal')" class="flex items-center space-x-2 bg-gradient-to-r from-electric-600 to-violet-600 hover:from-electric-500 hover:to-violet-500 text-white px-3.5 py-1.5 rounded-xl text-xs font-semibold shadow-md shadow-blue-500/25 transition">
                <i class="fa-solid fa-user-shield"></i>
                <span id="authBtnText">Account</span>
            </button>
        </div>
    </header>

    <!-- MAIN APP LAYOUT -->
    <div class="flex-1 flex overflow-hidden">
        
        <!-- SIDEBAR NAVIGATION -->
        <aside id="sidebar" class="w-64 bg-navy-800/95 border-r border-slate-800 flex flex-col transition-all duration-300 z-40 fixed inset-y-0 left-0 transform -translate-x-full md:relative md:translate-x-0 pt-16 md:pt-0">
            <div class="p-4 border-b border-slate-800/80 flex items-center justify-between md:hidden">
                <span class="text-sm font-bold text-slate-300">Navigation Menu</span>
                <button onclick="toggleMobileMenu()" class="text-slate-400 hover:text-white" aria-label="Close mobile menu"><i class="fa-solid fa-xmark text-lg"></i></button>
            </div>
            
            <div class="flex-1 overflow-y-auto custom-scrollbar p-3 space-y-6">
                <!-- Studios Section -->
                <div>
                    <p class="text-[10px] font-bold tracking-wider text-slate-400 uppercase px-3 mb-2" data-i18n="menuStudios">AI Studios</p>
                    <nav class="space-y-1">
                        <button onclick="switchTab('talkingPhoto')" class="nav-btn w-full flex items-center space-x-3 px-3.5 py-2.5 rounded-xl text-xs font-semibold text-cyan-400 bg-cyan-500/10 border border-cyan-500/30 transition group" data-tab="talkingPhoto">
                            <i class="fa-solid fa-face-smile text-cyan-400 w-5 text-center"></i>
                            <span data-i18n="tabTalkingPhoto">Talking Photo & Lip-Sync</span>
                        </button>
                        <button onclick="switchTab('textToVideo')" class="nav-btn w-full flex items-center space-x-3 px-3.5 py-2.5 rounded-xl text-xs font-medium text-slate-300 hover:bg-navy-700 hover:text-white transition group" data-tab="textToVideo">
                            <i class="fa-solid fa-video text-violet-400 w-5 text-center"></i>
                            <span data-i18n="tabTextToVideo">Cinematic Video</span>
                        </button>
                        <button onclick="switchTab('imageStudio')" class="nav-btn w-full flex items-center space-x-3 px-3.5 py-2.5 rounded-xl text-xs font-medium text-slate-300 hover:bg-navy-700 hover:text-white transition group" data-tab="imageStudio">
                            <i class="fa-solid fa-wand-magic-sparkles text-pink-400 w-5 text-center"></i>
                            <span data-i18n="tabImageStudio">AI Image Studio (12 Tools)</span>
                        </button>
                        <button onclick="switchTab('videoStudio')" class="nav-btn w-full flex items-center space-x-3 px-3.5 py-2.5 rounded-xl text-xs font-medium text-slate-300 hover:bg-navy-700 hover:text-white transition group" data-tab="videoStudio">
                            <i class="fa-solid fa-film text-amber-400 w-5 text-center"></i>
                            <span data-i18n="tabVideoStudio">Complete Video Studio</span>
                        </button>
                        <button onclick="switchTab('audioStudio')" class="nav-btn w-full flex items-center space-x-3 px-3.5 py-2.5 rounded-xl text-xs font-medium text-slate-300 hover:bg-navy-700 hover:text-white transition group" data-tab="audioStudio">
                            <i class="fa-solid fa-microphone-lines text-emerald-400 w-5 text-center"></i>
                            <span data-i18n="tabAudioStudio">Voice & Audio Studio</span>
                        </button>
                        <button onclick="switchTab('proEditor')" class="nav-btn w-full flex items-center space-x-3 px-3.5 py-2.5 rounded-xl text-xs font-medium text-slate-300 hover:bg-navy-700 hover:text-white transition group" data-tab="proEditor">
                            <i class="fa-solid fa-sliders text-blue-400 w-5 text-center"></i>
                            <span data-i18n="tabProEditor">Professional Video Editor</span>
                        </button>
                    </nav>
                </div>

                <!-- System & Management -->
                <div>
                    <p class="text-[10px] font-bold tracking-wider text-slate-400 uppercase px-3 mb-2" data-i18n="menuSystem">Management & Settings</p>
                    <nav class="space-y-1">
                        <button onclick="switchTab('providerConfig')" class="nav-btn w-full flex items-center space-x-3 px-3.5 py-2.5 rounded-xl text-xs font-medium text-slate-300 hover:bg-navy-700 hover:text-white transition group" data-tab="providerConfig">
                            <i class="fa-solid fa-server text-indigo-400 w-5 text-center"></i>
                            <span data-i18n="tabProviders">AI Provider Adapters</span>
                        </button>
                        <button onclick="switchTab('historyJobs')" class="nav-btn w-full flex items-center space-x-3 px-3.5 py-2.5 rounded-xl text-xs font-medium text-slate-300 hover:bg-navy-700 hover:text-white transition group" data-tab="historyJobs">
                            <i class="fa-solid fa-clock-rotate-left text-cyan-400 w-5 text-center"></i>
                            <span data-i18n="tabHistory">Job History & Cloud Storage</span>
                        </button>
                        <button onclick="openModal('upgradeModal')" class="w-full flex items-center space-x-3 px-3.5 py-2.5 rounded-xl text-xs font-medium text-amber-300 bg-amber-500/10 border border-amber-500/30 hover:bg-amber-500/20 transition group">
                            <i class="fa-solid fa-crown text-amber-400 w-5 text-center"></i>
                            <span data-i18n="tabUpgrade">Enterprise Plans & Quota</span>
                        </button>
                    </nav>
                </div>
            </div>

            <!-- Sidebar Footer: Ethical Notice & Version -->
            <div class="p-3 border-t border-slate-800 text-[11px] text-slate-400 bg-navy-900/50">
                <div class="flex items-center space-x-2 mb-1">
                    <i class="fa-solid fa-shield-halved text-cyan-400"></i>
                    <span class="font-semibold text-slate-300" data-i18n="ethicsTitle">Ethical AI Guarantee</span>
                </div>
                <p class="text-[10px] text-slate-400 leading-tight" data-i18n="ethicsDesc">Mandatory consent checks enforced for all talking photos & voice clones.</p>
                <div class="mt-2 pt-2 border-t border-slate-800 flex justify-between items-center text-[10px] text-slate-400">
                    <span>v2.8 Enterprise</span>
                    <span class="text-emerald-400">Secure Cloud</span>
                </div>
            </div>
        </aside>

        <!-- CONTENT AREA -->
        <main class="flex-1 overflow-y-auto custom-scrollbar bg-gradient-studio p-4 md:p-6 lg:p-8" id="mainContentArea">
            
            <!-- ==================== TAB 1: TALKING PHOTO & LIP-SYNC STUDIO ==================== -->
            <div id="tabContent-talkingPhoto" class="tab-pane space-y-6 max-w-7xl mx-auto">
                <div class="flex flex-col md:flex-row justify-between items-start md:items-center bg-navy-800/80 border border-slate-700/80 p-6 rounded-2xl shadow-xl backdrop-blur-md gap-4">
                    <div>
                        <div class="flex items-center space-x-2 text-cyan-400 text-xs font-bold uppercase tracking-wider mb-1">
                            <i class="fa-solid fa-star text-amber-400"></i> <span data-i18n="badgeFlagship">Flagship Cinematic AI Feature</span>
                        </div>
                        <h1 class="text-2xl md:text-3xl font-extrabold text-white tracking-tight" data-i18n="talkingTitle">Cinematic Talking Photo & Lip-Sync Studio</h1>
                        <p class="text-sm text-slate-400 mt-1" data-i18n="talkingSubtitle">Bring portraits to life with precise multilingual lip-sync, micro-expressions, and studio-grade cinematic rendering.</p>
                    </div>
                    <div class="flex items-center space-x-3">
                        <button onclick="loadDemoTalkingPhoto()" class="bg-navy-700 hover:bg-navy-600 text-slate-200 border border-slate-600 px-4 py-2.5 rounded-xl text-xs font-semibold transition flex items-center space-x-2">
                            <i class="fa-solid fa-flask text-cyan-400"></i> <span data-i18n="loadDemoBtn">Load Sample Model</span>
                        </button>
                        <button onclick="startTalkingPhotoGeneration()" class="bg-gradient-to-r from-cyan-500 to-electric-600 hover:from-cyan-400 hover:to-electric-500 text-navy-900 font-extrabold px-6 py-2.5 rounded-xl text-xs shadow-lg shadow-cyan-500/30 transition flex items-center space-x-2">
                            <i class="fa-solid fa-wand-magic text-navy-900"></i> <span data-i18n="generateVideoBtn">Generate Cinematic Video</span>
                        </button>
                    </div>
                </div>

                <!-- Ethical Consent Alert -->
                <div class="bg-amber-500/10 border border-amber-500/30 p-4 rounded-xl flex items-start space-x-3">
                    <i class="fa-solid fa-triangle-exclamation text-amber-400 text-lg mt-0.5"></i>
                    <div class="text-xs text-amber-200/90 leading-relaxed">
                        <span class="font-bold uppercase tracking-wider text-amber-300" data-i18n="consentHeader">Mandatory Consent & Verification:</span>
                        <span data-i18n="consentText">By generating a talking photo or cloned voice, you confirm that you have explicit legal permission or rights from the depicted individual. Impersonation and deceptive media without consent are strictly prohibited by Nivora AI safety protocols.</span>
                        <label class="flex items-center space-x-2 mt-2 cursor-pointer text-slate-300 font-medium">
                            <input type="checkbox" id="consentCheckbox" class="rounded bg-navy-900 border-amber-500/50 text-cyan-500 focus:ring-0">
                            <span data-i18n="consentCheckboxText">I verify that I own the rights or have explicit authorization to animate this portrait and audio.</span>
                        </label>
                    </div>
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                    <!-- Column 1: Portrait & Audio Input -->
                    <div class="space-y-6">
                        <!-- Portrait Upload Box -->
                        <div class="bg-navy-800/80 border border-slate-700/80 p-5 rounded-2xl shadow-lg">
                            <div class="flex justify-between items-center mb-3">
                                <label class="text-xs font-bold uppercase tracking-wider text-slate-300 flex items-center space-x-2">
                                    <i class="fa-solid fa-user-tie text-cyan-400"></i> <span data-i18n="step1Portrait">Step 1: Portrait Image</span>
                                </label>
                                <span class="text-[10px] text-slate-400">JPG, PNG, WebP (Max 15MB)</span>
                            </div>
                            <div id="portraitDropZone" class="border-2 border-dashed border-slate-700 hover:border-cyan-400/60 rounded-xl p-6 text-center cursor-pointer transition bg-navy-900/40 relative group overflow-hidden">
                                <input type="file" id="portraitFileInput" accept="image/*" class="absolute inset-0 opacity-0 cursor-pointer" onchange="handlePortraitUpload(event)" aria-label="Upload portrait image">
                                <div id="portraitPreviewContainer" class="hidden absolute inset-0 bg-navy-900 flex items-center justify-center">
                                    <img id="portraitPreviewImg" src="" alt="Portrait" class="max-h-full max-w-full object-contain rounded-lg">
                                    <button onclick="event.stopPropagation(); removePortrait();" class="absolute top-2 right-2 bg-red-600/80 hover:bg-red-600 text-white w-7 h-7 rounded-full flex items-center justify-center text-xs" aria-label="Remove portrait"><i class="fa-solid fa-xmark"></i></button>
                                </div>
                                <div id="portraitPlaceholder" class="space-y-2">
                                    <div class="w-12 h-12 rounded-full bg-cyan-500/10 border border-cyan-500/30 flex items-center justify-center mx-auto text-cyan-400 group-hover:scale-110 transition">
                                        <i class="fa-solid fa-cloud-arrow-up text-lg"></i>
                                    </div>
                                    <p class="text-xs font-semibold text-slate-200" data-i18n="dropPortrait">Click to upload or drag portrait here</p>
                                    <p class="text-[10px] text-slate-400" data-i18n="portraitHint">High-res frontal face recommended</p>
                                </div>
                            </div>
                        </div>

                        <!-- Audio Source Selection -->
                        <div class="bg-navy-800/80 border border-slate-700/80 p-5 rounded-2xl shadow-lg space-y-4">
                            <label class="text-xs font-bold uppercase tracking-wider text-slate-300 flex items-center space-x-2">
                                <i class="fa-solid fa-microphone-lines text-cyan-400"></i> <span data-i18n="step2Audio">Step 2: Audio Source</span>
                            </label>
                            
                            <!-- Audio Tabs -->
                            <div class="grid grid-cols-2 gap-2 bg-navy-900 p-1 rounded-xl border border-slate-700/60">
                                <button onclick="switchAudioMode('tts')" id="audioModeTtsBtn" class="py-2 text-xs font-bold rounded-lg bg-cyan-500 text-navy-900 transition shadow" data-i18n="audioModeTTS">Text-to-Speech</button>
                                <button onclick="switchAudioMode('upload')" id="audioModeUploadBtn" class="py-2 text-xs font-semibold rounded-lg text-slate-400 hover:text-white transition" data-i18n="audioModeUpload">Upload Audio</button>
                            </div>

                            <!-- TTS Panel -->
                            <div id="audioTtsPanel" class="space-y-3">
                                <div>
                                    <div class="flex justify-between items-center mb-1">
                                        <label class="text-[11px] font-semibold text-slate-300" data-i18n="speechScriptLabel">Speech Script & Prompt</label>
                                        <select id="ttsLanguage" class="bg-navy-900 border border-slate-700 text-[10px] rounded px-2 py-1 text-slate-200" aria-label="Text to speech language">
                                            <option value="en-US">English (US)</option>
                                            <option value="bn-BD">Bengali (বাংলা)</option>
                                            <option value="hi-IN">Hindi (हिन्दी)</option>
                                            <option value="ur-PK">Urdu (اردو)</option>
                                            <option value="ar-SA">Arabic (العربية)</option>
                                        </select>
                                    </div>
                                    <textarea id="ttsScriptInput" rows="4" class="w-full bg-navy-900 border border-slate-700 rounded-xl p-3 text-xs text-slate-200 focus:outline-none focus:border-cyan-400 custom-scrollbar" placeholder="Type or paste the script for the AI portrait to speak with natural cadence and lip-sync..."></textarea>
                                </div>
                                <div class="grid grid-cols-2 gap-3">
                                    <div>
                                        <label class="text-[10px] font-semibold text-slate-400 block mb-1" data-i18n="voicePersona">Voice Persona</label>
                                        <select id="ttsVoiceSelect" class="w-full bg-navy-900 border border-slate-700 text-xs rounded-xl p-2 text-slate-200" aria-label="Voice persona">
                                            <option value="Kore">Kore (Firm & Professional)</option>
                                            <option value="Zephyr">Zephyr (Bright & Engaging)</option>
                                            <option value="Puck">Puck (Upbeat & Energetic)</option>
                                            <option value="Charon">Charon (Deep & Authoritative)</option>
                                        </select>
                                    </div>
                                    <div>
                                        <label class="text-[10px] font-semibold text-slate-400 block mb-1" data-i18n="speechSpeed">Speech Speed</label>
                                        <select id="ttsSpeed" class="w-full bg-navy-900 border border-slate-700 text-xs rounded-xl p-2 text-slate-200" aria-label="Speech speed">
                                            <option value="0.9">0.9x (Calm)</option>
                                            <option value="1.0" selected>1.0x (Standard)</option>
                                            <option value="1.1">1.1x (Dynamic)</option>
                                        </select>
                                    </div>
                                </div>
                                <button onclick="generatePreviewTTS()" class="w-full bg-navy-700 hover:bg-navy-600 text-cyan-400 border border-cyan-500/30 py-2.5 rounded-xl text-xs font-semibold transition flex items-center justify-center space-x-2">
                                    <i class="fa-solid fa-volume-high"></i> <span data-i18n="previewTtsBtn">Synthesize & Preview Voice</span>
                                </button>
                            </div>

                            <!-- Upload Audio Panel -->
                            <div id="audioUploadPanel" class="hidden space-y-3">
                                <div class="border-2 border-dashed border-slate-700 hover:border-cyan-400/60 rounded-xl p-5 text-center cursor-pointer transition bg-navy-900/40 relative">
                                    <input type="file" id="audioFileInput" accept="audio/mp3,audio/wav,audio/m4a,audio/aac" class="absolute inset-0 opacity-0 cursor-pointer" onchange="handleAudioUpload(event)" aria-label="Upload audio file">
                                    <div class="space-y-1.5">
                                        <i class="fa-solid fa-file-audio text-cyan-400 text-xl"></i>
                                        <p class="text-xs font-semibold text-slate-200" data-i18n="audioUploadPrompt">Upload MP3, WAV, M4A, AAC</p>
                                        <p id="audioFileNameDisplay" class="text-[10px] text-slate-400">Max file size 50MB</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Column 2: Cinematic Video Parameters -->
                    <div class="space-y-6">
                        <div class="bg-navy-800/80 border border-slate-700/80 p-5 rounded-2xl shadow-lg space-y-4">
                            <label class="text-xs font-bold uppercase tracking-wider text-slate-300 flex items-center space-x-2">
                                <i class="fa-solid fa-sliders text-cyan-400"></i> <span data-i18n="step3Cinematic">Step 3: Cinematic Settings</span>
                            </label>

                            <!-- Camera Motion -->
                            <div>
                                <label class="text-[11px] font-semibold text-slate-300 block mb-1.5" data-i18n="cameraMotionLabel">Camera Movement</label>
                                <div class="grid grid-cols-2 gap-2">
                                    <button onclick="setCameraMotion('static')" id="camStatic" class="cam-btn bg-cyan-500/10 border border-cyan-500/50 text-cyan-300 py-2 rounded-xl text-xs font-semibold transition" data-i18n="camStatic">Static Camera</button>
                                    <button onclick="setCameraMotion('zoom')" id="camZoom" class="cam-btn bg-navy-900 border border-slate-700 text-slate-400 hover:text-white py-2 rounded-xl text-xs font-medium transition" data-i18n="camZoom">Slow Zoom</button>
                                    <button onclick="setCameraMotion('closeup')" id="camCloseup" class="cam-btn bg-navy-900 border border-slate-700 text-slate-400 hover:text-white py-2 rounded-xl text-xs font-medium transition" data-i18n="camCloseup">Cinematic Close-up</button>
                                    <button onclick="setCameraMotion('medium')" id="camMedium" class="cam-btn bg-navy-900 border border-slate-700 text-slate-400 hover:text-white py-2 rounded-xl text-xs font-medium transition" data-i18n="camMedium">Medium Shot</button>
                                </div>
                            </div>

                            <!-- Aspect Ratio -->
                            <div>
