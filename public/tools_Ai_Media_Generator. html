        let currentLang = 'en';

        function changeLanguage(lang) {
            currentLang = lang;
            const body = document.getElementById('bodyRoot');
            if (lang === 'ar' || lang === 'ur') {
                body.setAttribute('dir', 'rtl');
            } else {
                body.setAttribute('dir', 'ltr');
            }

            const dict = i18nData[lang] || i18nData['en'];
            document.querySelectorAll('[data-i18n]').forEach(el => {
                const key = el.getAttribute('data-i18n');
                if (dict[key]) {
                    el.innerText = dict[key];
                }
            });
            showToast(`Language switched successfully.`);
        }

        // Live Clock
        setInterval(() => {
            const now = new Date();
            document.getElementById('liveClock').innerText = now.toTimeString().split(' ')[0];
        }, 1000);

        // Toast Notification System
        function showToast(message) {
            const container = document.getElementById('toastContainer');
            const toast = document.createElement('div');
            toast.className = 'bg-navy-800 border border-cyan-500/50 text-slate-100 px-4 py-3 rounded-xl shadow-2xl text-xs flex items-center space-x-3 pointer-events-auto transform translate-y-2 opacity-0 transition-all duration-300';
            toast.innerHTML = `<i class="fa-solid fa-circle-check text-cyan-400 text-base"></i><span>${message}</span>`;
            container.appendChild(toast);
            setTimeout(() => { toast.classList.remove('translate-y-2', 'opacity-0'); }, 50);
            setTimeout(() => {
                toast.classList.add('translate-y-2', 'opacity-0');
                setTimeout(() => { toast.remove(); }, 300);
            }, 3500);
        }

        // Tab Switching Logic
        function switchTab(tabId) {
            document.querySelectorAll('.tab-pane').forEach(el => el.classList.add('hidden'));
            document.getElementById(`tabContent-${tabId}`).classList.remove('hidden');

            document.querySelectorAll('.nav-btn').forEach(btn => {
                btn.classList.remove('text-cyan-400', 'bg-cyan-500/10', 'border', 'border-cyan-500/30');
                btn.classList.add('text-slate-300', 'hover:bg-navy-700', 'hover:text-white');
            });
            const activeBtn = document.querySelector(`[data-tab="${tabId}"]`);
            if (activeBtn) {
                activeBtn.classList.add('text-cyan-400', 'bg-cyan-500/10', 'border', 'border-cyan-500/30');
                activeBtn.classList.remove('text-slate-300', 'hover:bg-navy-700', 'hover:text-white');
            }
        }

        // Mobile Menu Toggle
        document.getElementById('mobileMenuBtn').addEventListener('click', () => {
            const sidebar = document.getElementById('sidebar');
            sidebar.classList.toggle('-translate-x-full');
        });

        // Theme Toggle
        function toggleTheme() {
            document.documentElement.classList.toggle('dark');
            const icon = document.getElementById('themeIcon');
            icon.classList.toggle('fa-moon');
            icon.classList.toggle('fa-sun');
        }

        // Modal Handlers
        function openModal(modalId) {
            document.getElementById(modalId).classList.remove('hidden');
        }
        function closeModal(modalId) {
            document.getElementById(modalId).classList.add('hidden');
        }

        // Talking Photo & Audio State Handlers
        function switchAudioMode(mode) {
            const ttsBtn = document.getElementById('audioModeTtsBtn');
            const uploadBtn = document.getElementById('audioModeUploadBtn');
            const ttsPanel = document.getElementById('audioTtsPanel');
            const uploadPanel = document.getElementById('audioUploadPanel');

            if (mode === 'tts') {
                ttsBtn.className = 'py-2 text-xs font-bold rounded-lg bg-cyan-500 text-navy-900 transition shadow';
                uploadBtn.className = 'py-2 text-xs font-semibold rounded-lg text-slate-400 hover:text-white transition';
                ttsPanel.classList.remove('hidden');
                uploadPanel.classList.add('hidden');
            } else {
                uploadBtn.className = 'py-2 text-xs font-bold rounded-lg bg-cyan-500 text-navy-900 transition shadow';
                ttsBtn.className = 'py-2 text-xs font-semibold rounded-lg text-slate-400 hover:text-white transition';
                uploadPanel.classList.remove('hidden');
                ttsPanel.classList.add('hidden');
            }
        }

        function handlePortraitUpload(event) {
            const file = event.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    document.getElementById('portraitPreviewImg').src = e.target.result;
                    document.getElementById('portraitPreviewContainer').classList.remove('hidden');
                    document.getElementById('portraitPlaceholder').classList.add('hidden');
                    showToast('Portrait loaded successfully.');
                }
                reader.readAsDataURL(file);
            }
        }

        function removePortrait() {
            document.getElementById('portraitFileInput').value = '';
            document.getElementById('portraitPreviewContainer').classList.add('hidden');
            document.getElementById('portraitPlaceholder').classList.remove('hidden');
            showToast('Portrait removed.');
        }

        function handleAudioUpload(event) {
            const file = event.target.files[0];
            if (file) {
                document.getElementById('audioFileNameDisplay').innerText = `Selected: ${file.name}`;
                showToast('Audio file attached successfully.');
            }
        }

        function loadDemoTalkingPhoto() {
            document.getElementById('portraitPreviewImg').src = "https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=600&q=80";
            document.getElementById('portraitPreviewContainer').classList.remove('hidden');
            document.getElementById('portraitPlaceholder').classList.add('hidden');
            document.getElementById('ttsScriptInput').value = "Welcome to Nivora AI Media Studio. Experience enterprise cinematic video creation with flawless multilingual lip-sync and studio rendering.";
            document.getElementById('consentCheckbox').checked = true;
            showToast('Sample model & demo script loaded successfully.');
        }

        function setCameraMotion(motion) {
            document.querySelectorAll('.cam-btn').forEach(b => {
                b.className = 'cam-btn bg-navy-900 border border-slate-700 text-slate-400 hover:text-white py-2 rounded-xl text-xs font-medium transition';
            });
            document.getElementById(`cam${motion.charAt(0).toUpperCase() + motion.slice(1)}`).className = 'cam-btn bg-cyan-500/10 border border-cyan-500/50 text-cyan-300 py-2 rounded-xl text-xs font-semibold transition';
        }

        function setAspect(asp) {
            document.querySelectorAll('.asp-btn').forEach(b => {
                b.className = 'asp-btn bg-navy-900 border border-slate-700 text-slate-400 hover:text-white py-2 rounded-xl text-xs font-medium transition';
            });
            const id = asp === '16:9' ? 'asp169' : asp === '9:16' ? 'asp916' : 'asp11';
            document.getElementById(id).className = 'asp-btn bg-cyan-500/10 border border-cyan-500/50 text-cyan-300 py-2 rounded-xl text-xs font-semibold transition';
        }

        function generatePreviewTTS() {
            showToast('Synthesizing voice preview using Gemini TTS Engine...');
        }

        // Asynchronous Job Processing Simulation
        let currentJobInterval = null;

        function startTalkingPhotoGeneration() {
            const consent = document.getElementById('consentCheckbox').checked;
            if (!consent) {
                showToast('Please check the mandatory ethical consent box before generating.');
                return;
            }

            // Deduct credits
            let credits = parseInt(document.getElementById('userCreditsDisplay').innerText);
            if (credits < 20) {
                showToast('Insufficient credits! Please upgrade your enterprise plan.');
                openModal('upgradeModal');
                return;
            }
            credits -= 20;
            document.getElementById('userCreditsDisplay').innerText = credits;

            // Switch view states
            document.getElementById('renderIdleState').classList.add('hidden');
            document.getElementById('renderCompleteState').classList.add('hidden');
            document.getElementById('renderProcessingState').classList.remove('hidden');

            let progress = 0;
            const progressBar = document.getElementById('jobProgressBar');
            const percentText = document.getElementById('jobPercentText');
            const statusTitle = document.getElementById('jobStatusTitle');
            const statusSubtitle = document.getElementById('jobStatusSubtitle');

            const steps = [
                { p: 15, title: "Uploading Portrait & Audio to Cloud...", sub: "Secure S3 bucket validation & MIME type check" },
                { p: 40, title: "Running Cloudflare Worker /api/lipsync...", sub: "AI model analyzing facial landmarks & audio phonemes" },
                { p: 75, title: "Rendering Cinematic 1080p Video...", sub: "Applying background blur, color grading & frame interpolation" },
                { p: 95, title: "Finalizing MP4 & Auto Subtitles...", sub: "Encoding audio tracks and embedding closed captions" },
                { p: 100, title: "Render Complete!", sub: "Video successfully processed and ready for download" }
            ];

            let stepIdx = 0;
            clearInterval(currentJobInterval);
            currentJobInterval = setInterval(() => {
                progress += 2;
                if (progress > steps[stepIdx].p && stepIdx < steps.length - 1) {
                    stepIdx++;
                }
                progressBar.style.width = `${progress}%`;
                percentText.innerText = `${progress}%`;
                statusTitle.innerText = steps[stepIdx].title;
                statusSubtitle.innerText = steps[stepIdx].sub;

                if (progress >= 100) {
                    clearInterval(currentJobInterval);
                    setTimeout(() => {
                        document.getElementById('renderProcessingState').classList.add('hidden');
                        document.getElementById('renderCompleteState').classList.remove('hidden');
                        showToast('Cinematic Talking Photo video rendered successfully!');
                    }, 500);
                }
            }, 100);
        }

        function cancelCurrentJob() {
            clearInterval(currentJobInterval);
            document.getElementById('renderProcessingState').classList.add('hidden');
            document.getElementById('renderIdleState').classList.remove('hidden');
            showToast('Job cancelled successfully.');
        }

        function downloadFinalVideo() {
            showToast('Downloading NIVORA_Cinematic_TalkingPhoto_1080p.mp4...');
        }

        function openProEditorWithVideo() {
            switchTab('proEditor');
            showToast('Loaded video into Professional Timeline Editor.');
        }

        // Image Studio Tool Switcher
        function switchImageTool(toolId) {
            document.querySelectorAll('.img-tool-tab').forEach(b => {
                b.className = 'img-tool-tab px-4 py-2 rounded-xl text-xs font-medium bg-navy-800 text-slate-300 border border-slate-700 hover:bg-navy-700 transition';
            });
            event.target.className = 'img-tool-tab px-4 py-2 rounded-xl text-xs font-bold bg-cyan-500 text-navy-900 transition shadow';
            document.getElementById('activeImageToolTitle').innerHTML = `<i class="fa-solid fa-wand-magic-sparkles text-cyan-400"></i> <span>${event.target.innerText} Studio</span>`;
        }

        function runImageToolAction() {
            let credits = parseInt(document.getElementById('userCreditsDisplay').innerText);
            if (credits < 5) {
                showToast('Insufficient credits!');
                openModal('upgradeModal');
                return;
            }
            credits -= 5;
            document.getElementById('userCreditsDisplay').innerText = credits;
            showToast('AI Image Studio tool executed successfully.');
        }

        function downloadCurrentImage() {
            showToast('Downloading generated AI image asset...');
        }

        function startTextToVideoJob() {
            showToast('Text-to-Video cinematic scene generation started.');
        }

        function addStoryboardScene() {
            showToast('New storyboard scene added.');
        }

        function selectPlan(planName) {
            document.getElementById('planBadgeText').innerText = planName;
            closeModal('upgradeModal');
            showToast(`Successfully upgraded to ${planName} plan!`);
        }

        function performFirebaseSignIn() {
            closeModal('authModal');
            showToast('Successfully authenticated with Firebase & Firestore sync active.');
        }
    </script>
