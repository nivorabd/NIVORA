
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nivora",
  "main": "worker.js",
  "compatibility_date": "2026-10-12",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  }
}
